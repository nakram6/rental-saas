# -------------------------------------------------------
# Application
# -------------------------------------------------------
APP_NAME="Rental SaaS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_TIMEZONE=America/Toronto

# ---------------------------
# Maintenance Mode
# ---------------------------
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# -------------------------------------------------------
# Logging
# -------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug
LOG_DEPRECATIONS_CHANNEL=null

# -------------------------------------------------------
# Database (MySQL for SaaS)
# -------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rental_saas
DB_USERNAME=root
DB_PASSWORD=

# -------------------------------------------------------
# Session, Cache, Queue
# -------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_DOMAIN=localhost
SESSION_PATH=/

CACHE_STORE=database
QUEUE_CONNECTION=database

# Redis (optional, recommended for SaaS)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# -------------------------------------------------------
# Mail (for login, notifications, booking confirmations)
# -------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@rental-saas.test"
MAIL_FROM_NAME="${APP_NAME}"

# -------------------------------------------------------
# File Storage / S3
# -------------------------------------------------------
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# -------------------------------------------------------
# Sanctum + SPA / React Settings
# -------------------------------------------------------
# The frontend dev server URL (React)
FRONTEND_URL=http://localhost:5173

# Sanctum session domain list
SANCTUM_STATEFUL_DOMAINS=localhost:5173

SPA_URL=http://localhost:5173

# -------------------------------------------------------
# Broadcasting (optional)
# -------------------------------------------------------
BROADCAST_CONNECTION=log

# -------------------------------------------------------
# Vite / Frontend
# -------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"
VITE_DEV_SERVER_URL=http://localhost:5173

# -------------------------------------------------------
# Multi-Tenant SaaS Settings
# -------------------------------------------------------
# Example:
# tenant1.localhost
# decor.localhost
TENANCY_BASE_DOMAIN=localhost

ALLOW_TENANT_CUSTOM_DOMAINS=true

# -------------------------------------------------------
# Stripe Billing (for SaaS subscriptions)
# -------------------------------------------------------
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
